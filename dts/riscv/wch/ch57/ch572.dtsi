#include <wch/ch57/ch570.dtsi>

/ {
	soc {
		usb: usb@40008000 {
			compatible = "wch,ch5xx-usb";
			reg = <0x40008000 0x70>;
			interrupt-parent = <&pfic>;
			interrupts = <22>;
			num-bidir-endpoints = <8>;
			status = "disabled";
		};
	};
};
